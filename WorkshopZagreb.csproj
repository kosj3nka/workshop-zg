<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets `dotnet user-secrets` store a local dev Admin:PasswordHash outside
         the repo, so it's never confused with (or overwrites) the real
         appsettings.json credential. ASP.NET Core loads user secrets
         automatically in Development — no Program.cs change needed. -->
    <UserSecretsId>b8f5f3f0-6a8f-4b1a-9e02-workshopzagreb-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core with SQLite (swap ConnectionString for Azure SQL later) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Password hashing for admin login -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Email sending via Google Workspace SMTP -->
    <PackageReference Include="MailKit" Version="4.7.1" />
  </ItemGroup>

</Project>
