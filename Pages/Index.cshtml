@page
@model IndexModel
@{
    ViewData["IsHome"] = true;
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Jutarnja kava, poslijepodnevna kreativnost. Svaki tjedan nova radionica u srcu Zagreba — akvarel, keramika, fotografija i više.";
    Layout = "_Layout";
}

<!-- ============= HERO ============= -->
<section class="hero">
    <video class="hero-video" autoplay muted loop playsinline poster="/images/lokacija.jpg">
        <source src="/videos/hero.mp4" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <img src="/images/justLogo.png" alt="Workshop Zagreb" class="hero-logo-img" />
        <h1 class="hero-tagline">
            Mornings for coffee.<br>Afternoons for creativity!
        </h1>
        <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
            <a href="/workshops" class="btn btn-primary">Browse Workshops</a>
            <a href="#discover"  class="btn btn-ghost">Learn More</a>
        </div>
    </div>
    <div class="hero-scroll">scroll</div>
</section>

<!-- ============= CTA ============= -->
<section class="cta-section" id="discover">
    <h2>Find Your Workshop</h2>
    <p>From sushi and flower making to runner clubs — a new opportunity each week to make something with your hands or meet new people, over good coffee.</p>
    <div class="cta-buttons">
        <a href="/workshops" class="btn btn-primary">Book a Workshop</a>
        <a href="/about#find-us" class="btn btn-outline">How to Find Us</a>
    </div>
</section>


<!-- ============= PHOTO STRIP ============= -->
<section class="photo-strip">
    <div class="photo-strip-inner">
        <div class="photo-strip-item">
            <img src="/images/brunch.jpg" alt="Food at Workshop Zagreb" />
            <div class="photo-strip-caption">Food &amp; Coffee</div>
        </div>
        <div class="photo-strip-item photo-strip-item--tall">
            <img src="/images/unutra.webp" alt="Our space" />
            <div class="photo-strip-caption">Our Space</div>
        </div>
        <div class="photo-strip-item">
            <img src="/images/macha.jpg" alt="Specialty drinks" />
            <div class="photo-strip-caption">Specialty Drinks</div>
        </div>
    </div>
</section>

<!-- ============= PROMO CAROUSEL ============= -->
@if (Model.Promos.Any())
{
    <section class="promo-carousel"
             x-data="{ active: 0, count: @Model.Promos.Count }"
             x-init="count > 1 && setInterval(() => { active = (active + 1) % count }, 4000)">
        @for (int i = 0; i < Model.Promos.Count; i++)
        {
            var promo = Model.Promos[i];
            var focalPosition = $"{promo.FocalX.ToString(System.Globalization.CultureInfo.InvariantCulture)}% {promo.FocalY.ToString(System.Globalization.CultureInfo.InvariantCulture)}%";
            <div class="promo-slide" :class="active === @i ? 'promo-slide--active' : ''">
                @if (promo.IsVideo)
                {
                    <video autoplay muted loop playsinline style="object-position: @focalPosition;">
                        <source src="@promo.ImageUrl" />
                    </video>
                }
                else
                {
                    <img src="@promo.ImageUrl" alt="@promo.Heading" style="object-position: @focalPosition;" />
                }
                @if (!string.IsNullOrEmpty(promo.Heading) || !string.IsNullOrEmpty(promo.Subheading))
                {
                    <div class="promo-slide-overlay"></div>
                    <div class="promo-slide-text">
                        @if (!string.IsNullOrEmpty(promo.Heading))
                        {
                            <h2 class="promo-slide-heading">@promo.Heading</h2>
                        }
                        @if (!string.IsNullOrEmpty(promo.Subheading))
                        {
                            <p class="promo-slide-subheading">@promo.Subheading</p>
                        }
                    </div>
                }
            </div>
        }
    </section>
}


<!-- ============= UPCOMING WORKSHOPS ============= -->
<section class="workshops-section">
    <div class="section-header">
        <h2>Upcoming Workshops</h2>
        <a href="/workshops">All workshops →</a>
    </div>

    @if (Model.UpcomingWorkshops.Any() || Model.ReservableWorkshops.Any())
    {
        <div class="workshops-scroll-track">
            @foreach (var w in Model.UpcomingWorkshops)
            {
                var occ = Model.NextOccurrenceByWorkshopId[w.Id];
                var extraCount = Model.UpcomingOccurrenceCountByWorkshopId[w.Id] - 1;
                @await Html.PartialAsync("_WorkshopCard", (w, (WorkshopOccurrence?)occ, extraCount))
            }
            @foreach (var p in Model.ReservableWorkshops)
            {
                @await Html.PartialAsync("_WorkshopCard", (p, (WorkshopOccurrence?)null, 0))
            }
        </div>
    }
    else
    {
        <div class="workshops-empty"><p>No upcoming workshops at the moment. Follow us on Instagram for updates!</p></div>
    }
</section>

<!-- ============= CALENDAR ============= -->
<section class="calendar-section">
    <div class="calendar-section-header">
        <h2>Workshop Calendar</h2>
        <p>Click a workshop to view details and reserve a spot</p>
    </div>

    <div class="calendar-wrapper" x-data="{ activeMonth: 0 }">

        <!-- Mobile month switcher -->
        <div class="calendar-mobile-nav">
            <button class="cal-nav-btn" @@click="activeMonth = 0" :class="activeMonth===0 ? 'active':''">
                @Model.CurrentMonthName
            </button>
            <button class="cal-nav-btn" @@click="activeMonth = 1" :class="activeMonth===1 ? 'active':''">
                @Model.NextMonthName
            </button>
        </div>

        <div class="calendar-grid-outer">

            <!-- CURRENT MONTH -->
            <div class="calendar-month" :class="{ 'cal-hidden-mobile': activeMonth !== 0 }">
                <h3 class="cal-month-title">@Model.CurrentMonthName @Model.CurrentYear</h3>
                <div class="cal-day-headers">
                    <span>Mon</span><span>Tue</span><span>Wed</span>
                    <span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                </div>
                <div class="cal-days-grid">
                    @{
                        var firstDayOfWeek = ((int)Model.CurrentMonthStart.DayOfWeek + 6) % 7;
                        for (int blank = 0; blank < firstDayOfWeek; blank++)
                        {
                            <div class="cal-day cal-day--empty"></div>
                        }
                        for (int d = 1; d <= Model.CurrentMonthDays; d++)
                        {
                            var date     = new DateTime(Model.CurrentMonthStart.Year, Model.CurrentMonthStart.Month, d);
                            var ws       = Model.WorkshopsByDate.TryGetValue(date, out var list) ? list : new();
                            var reserved    = Model.ReservedDays.TryGetValue(date, out var rd1) ? rd1 : null;
                            bool isToday    = date == DateTime.Today;
                            bool isNonWork  = date.DayOfWeek == DayOfWeek.Sunday || Model.Holidays.Contains(date);
                            var logoEntry = ws.FirstOrDefault(e => !string.IsNullOrEmpty(e.Workshop.LogoUrl));
                            @if (ws.Any())
                            {
                                <a href="/workshops/@ws.First().Workshop.Slug" class="cal-day @(isToday ? "cal-day--today" : "") cal-day--has-event @(reserved != null ? "cal-day--reserved" : "") @(isNonWork ? "cal-day--nonworking" : "")">
                                    <span class="cal-day-num">@d</span>
                                    @if (logoEntry.Workshop != null)
                                    {
                                        <img src="@logoEntry.Workshop.LogoUrl" class="cal-day-logo" alt="" />
                                    }
                                    @if (reserved != null && !string.IsNullOrEmpty(reserved.Label))
                                    {
                                        <span class="cal-reserved-label">@reserved.Label</span>
                                    }
                                    @foreach (var entry in ws)
                                    {
                                        <span class="cal-event">
                                            <span class="cal-event-name">@entry.Workshop.Name</span>
                                        </span>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="cal-day @(isToday ? "cal-day--today" : "") @(reserved != null ? "cal-day--reserved" : "") @(isNonWork ? "cal-day--nonworking" : "")">
                                    <span class="cal-day-num">@d</span>
                                    @if (reserved != null && !string.IsNullOrEmpty(reserved.Label))
                                    {
                                        <span class="cal-reserved-label">@reserved.Label</span>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <!-- NEXT MONTH -->
            <div class="calendar-month" :class="{ 'cal-hidden-mobile': activeMonth !== 1 }">
                <h3 class="cal-month-title">@Model.NextMonthName @Model.NextYear</h3>
                <div class="cal-day-headers">
                    <span>Mon</span><span>Tue</span><span>Wed</span>
                    <span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                </div>
                <div class="cal-days-grid">
                    @{
                        var firstDayNext = ((int)Model.NextMonthStart.DayOfWeek + 6) % 7;
                        for (int blank = 0; blank < firstDayNext; blank++)
                        {
                            <div class="cal-day cal-day--empty"></div>
                        }
                        for (int d = 1; d <= Model.NextMonthDays; d++)
                        {
                            var date     = new DateTime(Model.NextMonthStart.Year, Model.NextMonthStart.Month, d);
                            var ws       = Model.WorkshopsByDate.TryGetValue(date, out var list2) ? list2 : new();
                            var reserved    = Model.ReservedDays.TryGetValue(date, out var rd2) ? rd2 : null;
                            bool isToday    = date == DateTime.Today;
                            bool isNonWork2 = date.DayOfWeek == DayOfWeek.Sunday || Model.Holidays.Contains(date);
                            var logoEntry = ws.FirstOrDefault(e => !string.IsNullOrEmpty(e.Workshop.LogoUrl));
                            @if (ws.Any())
                            {
                                <a href="/workshops/@ws.First().Workshop.Slug" class="cal-day @(isToday ? "cal-day--today" : "") cal-day--has-event @(reserved != null ? "cal-day--reserved" : "") @(isNonWork2 ? "cal-day--nonworking" : "")">
                                    <span class="cal-day-num">@d</span>
                                    @if (logoEntry.Workshop != null)
                                    {
                                        <img src="@logoEntry.Workshop.LogoUrl" class="cal-day-logo" alt="" />
                                    }
                                    @if (reserved != null && !string.IsNullOrEmpty(reserved.Label))
                                    {
                                        <span class="cal-reserved-label">@reserved.Label</span>
                                    }
                                    @foreach (var entry in ws)
                                    {
                                        <span class="cal-event">
                                            <span class="cal-event-name">@entry.Workshop.Name</span>
                                        </span>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="cal-day @(isToday ? "cal-day--today" : "") @(reserved != null ? "cal-day--reserved" : "") @(isNonWork2 ? "cal-day--nonworking" : "")">
                                    <span class="cal-day-num">@d</span>
                                    @if (reserved != null && !string.IsNullOrEmpty(reserved.Label))
                                    {
                                        <span class="cal-reserved-label">@reserved.Label</span>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            </div>

        </div><!-- /calendar-grid-outer -->
    </div><!-- /calendar-wrapper -->
</section>

<!-- ============= MOOD SPLIT ============= -->
<section class="mood-split">
    <div class="mood-split-img">
         <img src="/images/prostor.jpg" alt="Workshop Zagreb interior" />
    </div>
    <div class="mood-split-text">
        <span class="mood-eyebrow">Our Space</span>
        <h2>A hybrid creative space in the heart of Zagreb</h2>
        <p>Light, simple, and warm — we're tucked beside Ribnjak park, at Henrik Degen 2.</p>
        <p>Until 3 pm, specialty coffee and snacks. After 3 pm, workshops, conversation, inspiration.</p>
        <a href="/about" class="btn btn-ghost" style="margin-top:28px;width:fit-content;">Learn More About Us</a>
    </div>
</section>

<!-- ============= QUAD PHOTO GRID ============= -->
<section class="quad-grid-section">
    <div class="quad-grid">
        <div class="quad-item quad-item--decor">
            <img src="/images/dekor.webp" alt="Workshop Zagreb counter decor" />
            <div class="quad-overlay"><span>The Details</span></div>
        </div>
        <div class="quad-item quad-item--feature">
            <img src="/images/outsideDrawing.png" alt="Illustration of the Workshop Zagreb storefront" />
            <div class="quad-overlay"><span>The Space</span></div>
        </div>
        <div class="quad-item quad-item--bar">
            <img src="/images/sank.jpg" alt="Workshop Zagreb bar" />
            <div class="quad-overlay"><span>The Bar</span></div>
        </div>
        
    </div>
</section>

<!-- ============= NEWSLETTER ============= -->
<section class="home-newsletter">
    <div class="home-newsletter-inner">
        <div class="home-newsletter-text">
            <p class="mood-eyebrow">Newsletter</p>
            <h2>Budite prvi kada stignu nove radionice.</h2>
            <p>Obavijest čim otvorimo novu radionicu, tako da ste uvijek informirai o novim događajima.</p>
        </div>
        <form class="home-newsletter-form"
              x-data="{ email:'', submitted:false, error:'' }"
              x-on:submit.prevent="
                fetch('/api/subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ email }) })
                  .then(r => r.json())
                  .then(d => { if (d.ok) { submitted = true; localStorage.setItem('newsletter_subscribed','1'); } else { error = d.message || 'Greška.'; } })
                  .catch(() => { error = 'Greška. Pokušajte ponovo.'; })
              ">
            <template x-if="submitted">
                <p class="home-newsletter-thanks">Hvala! Provjerite inbox.</p>
            </template>
            <template x-if="!submitted">
                <div class="home-newsletter-row">
                    <input type="email" x-model="email" placeholder="vaš@email.com" required class="home-newsletter-input" />
                    <button type="submit" class="btn btn-primary">Prijavi se</button>
                </div>
            </template>
            <p x-show="error" x-text="error" style="color:#c0392b;font-size:0.8rem;margin-top:8px;"></p>
            <p class="home-newsletter-gdpr">Prijavom prihvaćate našu <a href="/privacy">politiku privatnosti</a>.</p>
        </form>
    </div>
</section>

<!-- ============= INSTAGRAM CTA ============= -->
<section class="instagram-cta">
    <p class="mood-eyebrow">Follow Us</p>
    <h2>@@workshop.zagreb</h2>
    <p>Workshops, news, and daily atmosphere — all on Instagram.</p>
    <a href="https://www.instagram.com/workshop.zagreb/" target="_blank" rel="noopener"
       class="btn btn-primary" style="margin-top:28px;">
        Open Instagram ↗
    </a>
</section>
