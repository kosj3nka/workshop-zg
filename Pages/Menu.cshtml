@page
@model WorkshopZagreb.Pages.MenuModel
@{ ViewData["Title"] = "Meni"; }

@{
    // Split the drink categories roughly in half so they balance into two columns,
    // the same way the page used to look when the menu was hardcoded.
    int half = (Model.DrinkCategories.Count + 1) / 2;
    var drinksLeft  = Model.DrinkCategories.Take(half).ToList();
    var drinksRight = Model.DrinkCategories.Skip(half).ToList();

    int foodHalf = (Model.FoodCategories.Count + 1) / 2;
    var foodLeft  = Model.FoodCategories.Take(foodHalf).ToList();
    var foodRight = Model.FoodCategories.Skip(foodHalf).ToList();
}

<div class="static-page">
    <div class="static-page-header">
        <h1>Meni</h1>
        <p>Jutarnja kava je obaveza. Ostatak je bonus.</p>
    </div>

    <p class="menu-notice">Primamo isključivo kartično plaćanje. Hvala!</p>

    <div class="menu-grid">

        <!-- LEFT COLUMN -->
        <div>
            @if (!Model.DrinkCategories.Any())
            {
                <p style="opacity:0.6;">Meni se uskoro ažurira.</p>
            }
            @foreach (var cat in drinksLeft)
            {
                @await Html.PartialAsync("_MenuCategory", cat)
            }
        </div>

        <!-- RIGHT COLUMN -->
        <div>
            @foreach (var cat in drinksRight)
            {
                @await Html.PartialAsync("_MenuCategory", cat)
            }
        </div>

        <p class="menu-legal">Zabranjeno je usluživanje alkoholnih pića osobama mlađim od 18 godina.</p>

    </div>

    @if (Model.FoodCategories.Any())
    {
        <div class="static-page-header" style="margin-top:48px;">
            <h2>Hrana</h2>
        </div>

        <div class="menu-grid">
            <div>
                @foreach (var cat in foodLeft)
                {
                    @await Html.PartialAsync("_MenuCategory", cat)
                }
            </div>
            <div>
                @foreach (var cat in foodRight)
                {
                    @await Html.PartialAsync("_MenuCategory", cat)
                }
            </div>
        </div>
    }
</div>
