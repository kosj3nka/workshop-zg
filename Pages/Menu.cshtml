@page
@model WorkshopZagreb.Pages.MenuModel
@{
    ViewData["Title"] = "Meni";
    ViewData["Description"] = "Meni Workshop Zagreb — specialty kava, čajevi, matcha, sokovi i lagani zalogaji. Jutro za kavu, poslijepodne za kreativnost.";
}

@{
    // Balance columns by item count (not just category count) so neither column
    // ends up much taller than the other regardless of how items are distributed
    // across categories.
    var (drinksLeft, drinksRight) = MenuModel.SplitIntoBalancedColumns(Model.DrinkCategories);
    var (foodLeft, foodRight) = MenuModel.SplitIntoBalancedColumns(Model.FoodCategories);
}

<div class="static-page">
    <div class="static-page-header">
        <h1>Meni <img src="/images/flower.png" alt="" class="menu-title-icon" /></h1>
    </div>

    <p class="menu-notice">Primamo isključivo kartično plaćanje. Hvala!</p>

    <div class="menu-grid">

        <!-- LEFT COLUMN -->
        <div>
            @if (!Model.DrinkCategories.Any())
            {
                <p style="opacity:0.6;">Meni se uskoro ažurira.</p>
            }
            @foreach (var cat in drinksLeft)
            {
                @await Html.PartialAsync("_MenuCategory", cat)
            }
        </div>

        <!-- RIGHT COLUMN -->
        <div>
            @foreach (var cat in drinksRight)
            {
                @await Html.PartialAsync("_MenuCategory", cat)
            }
        </div>

        <p class="menu-legal">Zabranjeno je usluživanje alkoholnih pića osobama mlađim od 18 godina.</p>

    </div>

    @if (Model.FoodCategories.Any())
    {
        <div class="static-page-header" style="margin-top:48px;">
            <h2>Hrana</h2>
        </div>

        <div class="menu-grid">
            <div>
                @foreach (var cat in foodLeft)
                {
                    @await Html.PartialAsync("_MenuCategory", cat)
                }
            </div>
            <div>
                @foreach (var cat in foodRight)
                {
                    @await Html.PartialAsync("_MenuCategory", cat)
                }
            </div>
        </div>
    }
</div>
