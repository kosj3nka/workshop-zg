@page
@model WorkshopZagreb.Pages.FaqModel
@{
    ViewData["Title"] = "FAQ";
    ViewData["Description"] = "Odgovori na najčešća pitanja o radionicama u Workshop Zagrebu — ulaznice, cijene, materijali, povrati i više.";
}

<div class="static-page">
    <div class="static-page-header">
        <h1>Često postavljana pitanja</h1>
        <p>Ako ne nađete odgovor, javite nam se na Instagramu.</p>
    </div>

    <!-- Alpine.js x-data on the container tracks which item is open by index -->
    <div class="static-content" x-data="{ open: null }">

        @{
            var faqs = new[]
            {
                ("Trebam li predznanje za radionice?",
                 "Ne! Sve naše radionice su osmišljene za potpune početnike. Voditelji objasne sve od početka, a mi osiguravamo sav materijal."),

                ("Što je uključeno u cijenu radionice?",
                 "Sav materijal i pribor za rad, kava ili čaj dobrodošlice i dobre vibracije. Ponekad i sitni zalogaj — to saznate u opisu svake radionice."),

                ("Kako kupiti ulaznicu?",
                 "Ulaznice se kupuju putem Entrio platforme — gumb 'Kupi ulaznicu' na stranici svake radionice odvest će vas tamo. Entrio šalje potvrdu i QR kod na vaš email."),

                ("Mogu li dobiti povrat novca ako ne mogu doći?",
                 "Povrat je moguć do 48 sati prije radionice. Nakon toga nažalost nije moguće jer smo već naručili materijal. Možete prebaciti ulaznicu na drugu osobu."),

                

                ("Mogu li organizirati privatnu radionicu za grupu?",
                 "Apsolutno! Pošaljite upit na Collaborate stranici ili nam se javite na Instagram i dogovorimo detalje. Radimo privatne radionice za ekipe, rođendane, team buildinge i jednom smo čak imali i vjenčanje ;)"),

                ("Što sve nudi Workshop Zagreb?",
                 "Workshop Zagreb je kreativni hibridni kafić na Henriku Degenu 2 u Zagrebu, uz Ribnjak park. Ujutro specialty kava i zalogaji — poslijepodne tjedne kreativne radionice (akvarel, keramika, fotografija, printmaking i više), otvorene za početnike. Prostor je dostupan i za privatne evente: proslave rođendana, team buildinge, djevojačke večeri i privatne radionice za grupe do 15 osoba. Neovisni kreativci i stručnjaci mogu ga zakupiti za vlastite radionice. Sve upite šaljite putem stranice Suradnja.")
            };
        }

        @{
            var faqJson = new System.Text.StringBuilder();
            faqJson.Append("[");
            for (int fi = 0; fi < faqs.Length; fi++)
            {
                if (fi > 0) faqJson.Append(",");
                var (q, a) = faqs[fi];
                faqJson.Append($"{{\"@@type\":\"Question\",\"name\":{System.Text.Json.JsonSerializer.Serialize(q)},\"acceptedAnswer\":{{\"@@type\":\"Answer\",\"text\":{System.Text.Json.JsonSerializer.Serialize(a)}}}}}");
            }
            faqJson.Append("]");
        }
        <script type="application/ld+json">
        {"@@context":"https://schema.org","@@type":"FAQPage","mainEntity":@Html.Raw(faqJson.ToString())}
        </script>

        @for (int i = 0; i < faqs.Length; i++)
        {
            var (question, answer) = faqs[i];
            var idx = i;
            <div class="faq-item">
                <button class="faq-question" @@click="open = open === @idx ? null : @idx">
                    @question
                    <span class="faq-icon" :style="open === @idx ? 'transform:rotate(45deg)' : ''">+</span>
                </button>
                <div class="faq-answer" x-show="open === @idx" x-transition>
                    @answer
                </div>
            </div>
        }
    </div>
</div>
