@page "/admin/pinned/{action}/{id:int?}"
@model WorkshopZagreb.Pages.Admin.Pinned.PinnedEditModel
@{
    Layout = "_AdminLayout";
    bool isNew = Model.IsNew;
    ViewData["Title"] = isNew ? "Novi rezervabilni event" : "Uredi event";
}

<div style="margin-bottom:24px;">
    <a href="/admin" style="font-size:0.85rem; color:var(--terracotta);">← Natrag na popis</a>
</div>

<h1 class="admin-page-title">@(isNew ? "Novi rezervabilni event" : "Uredi: " + Model.Input.Name)</h1>

<form method="post" enctype="multipart/form-data" class="form-card">
    <input type="hidden" name="Input.Id" value="@Model.Input.Id" />

    <p class="form-section-title">Osnovni podaci</p>

    <div class="form-group">
        <label class="form-label">Naziv <span class="required">*</span></label>
        <input type="text" name="Input.Name" value="@Model.Input.Name"
               class="form-control" required placeholder="npr. Rođendanska radionica" />
    </div>

    <div class="form-group">
        <label class="form-label">Podnaslov <span style="opacity:0.5;font-weight:400;">(opcionalno)</span></label>
        <input type="text" name="Input.Subtitle" value="@Model.Input.Subtitle"
               class="form-control" placeholder="npr. Privatni event za do 15 osoba" />
    </div>

    <div class="form-group">
        <label class="form-label">Opis <span class="required">*</span></label>
        <textarea name="Input.Description" class="form-control" required rows="4"
                  placeholder="Opišite što gosti dobivaju...">@Model.Input.Description</textarea>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Početna cijena (€)</label>
            <input type="number" name="Input.StartingPrice" value="@Model.Input.StartingPrice"
                   class="form-control" min="0" step="1" placeholder="npr. 25" />
            <p class="form-hint">Prikazuje se kao "od X €". Prazno = bez cijene.</p>
        </div>
        <div class="form-group">
            <label class="form-label">Redoslijed prikaza</label>
            <input type="number" name="Input.DisplayOrder" value="@Model.Input.DisplayOrder"
                   class="form-control" min="0" />
            <p class="form-hint">Niži broj = ranije na listi.</p>
        </div>
    </div>

    <div class="form-group">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
            <input type="hidden" name="Input.IsActive" value="false" />
            <input type="checkbox" name="Input.IsActive" value="true"
                   @(Model.Input.IsActive ? "checked" : "") style="width:16px;height:16px;" />
            <span class="form-label" style="margin:0;">Aktivan (vidljiv posjetiteljima)</span>
        </label>
    </div>

    <p class="form-section-title">Slika</p>

    <div class="form-group">
        <label class="form-label">Banner slika</label>
        @if (!string.IsNullOrEmpty(Model.Input.ExistingBannerUrl))
        {
            <div style="margin-bottom:12px;">
                <img src="@Model.Input.ExistingBannerUrl" alt="current banner"
                     style="width:100%; max-height:180px; object-fit:cover;" />
                <p class="form-hint">Trenutna slika. Uploadajte novu za zamjenu.</p>
            </div>
        }
        <input type="file" name="BannerFile" class="form-control"
               accept="image/png,image/jpeg,image/webp" />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">
            @(isNew ? "Objavi" : "Spremi promjene")
        </button>
        <a href="/admin" class="btn btn-outline">Odustani</a>
    </div>
</form>
