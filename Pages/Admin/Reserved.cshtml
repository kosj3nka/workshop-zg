@page
@model WorkshopZagreb.Pages.Admin.ReservedModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reserved Days";
}

<div class="admin-top-bar">
    <h1 class="admin-page-title">Reserved Days</h1>
</div>

<p style="font-size:0.88rem;opacity:0.6;margin-bottom:32px;max-width:520px;">
    Mark dates as reserved for private events, closures, or holidays.
    They appear as lightly shaded cells in the public calendar.
    Sundays are automatically shaded without needing an entry here.
</p>

<!-- ADD FORM -->
<form method="post" asp-page-handler="Add" class="form-card" style="margin-bottom:32px;">
    <div class="form-row">
        <div class="form-group">
            <label class="form-label">Date <span class="required">*</span></label>
            <input type="date" name="Date" class="form-control" required
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label class="form-label">Label <span style="font-weight:400;font-size:0.9rem;opacity:0.6;">(optional)</span></label>
            <input type="text" name="Label" class="form-control"
                   placeholder="e.g. Private event, Closed" maxlength="40" />
            <p class="form-hint">Shown inside the calendar cell if provided.</p>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Add day</button>
    </div>
</form>

<!-- EXISTING LIST -->
@if (!Model.Reserved.Any())
{
    <div class="workshops-empty" style="padding:40px 0;">
        <p>No reserved days yet.</p>
    </div>
}
else
{
    <div class="admin-list">
        @foreach (var r in Model.Reserved)
        {
            <div class="admin-list-item">
                <div class="admin-list-item-info">
                    <h3>@r.Date.ToString("dddd, MMMM d, yyyy", new System.Globalization.CultureInfo("en-US"))</h3>
                    <p>@(string.IsNullOrEmpty(r.Label) ? "No label" : r.Label)</p>
                </div>
                <div class="admin-list-item-actions">
                    <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id"
                          onsubmit="return confirm('Remove this reserved day?')">
                        <button type="submit" class="btn-icon-danger" title="Remove">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
