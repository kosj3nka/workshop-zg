@page
@model WorkshopZagreb.Pages.Admin.SetPasswordModel
@{ Layout = null; }
<!DOCTYPE html>
<html><head><meta charset="utf-8"/><title>Set Password</title>
<style>body{font-family:monospace;padding:40px;max-width:600px;}
input{width:100%;padding:8px;margin:8px 0;font-size:1rem;}
button{padding:10px 20px;background:#C1683A;color:white;border:none;cursor:pointer;font-size:1rem;}
pre{background:#f0f0f0;padding:16px;word-break:break-all;}</style></head>
<body>
<h2>Postavi admin lozinku (jednokratno)</h2>
<p>Unesite lozinku, kopirajte hash i zalijepite ga u appsettings.json pod Admin:PasswordHash. Zatim obrišite ovaj link.</p>
<form method="post">
    <input type="password" name="password" placeholder="Nova lozinka" required />
    <button type="submit">Generiraj hash</button>
</form>
@if (!string.IsNullOrEmpty(Model.Hash))
{
    <p>Zalijepite ovo u <strong>appsettings.json → Admin:PasswordHash</strong>:</p>
    <pre>@Model.Hash</pre>
}
</body></html>
