@page "/admin/promos"
@model WorkshopZagreb.Pages.Admin.Promos.PromoIndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Promo";
}

<div class="admin-top-bar">
    <h1 class="admin-page-title">Promo</h1>
    <a href="/admin/promos/new" class="btn btn-primary">+ Dodaj promo</a>
</div>

@if (!Model.Promos.Any())
{
    <div class="workshops-empty">
        <p>Nema promo slajdova. <a href="/admin/promos/new" style="color:var(--terracotta)">Dodaj prvi →</a></p>
    </div>
}
else
{
    <div class="admin-list">
        @foreach (var p in Model.Promos)
        {
            <div class="admin-list-item" onclick="location.href='/admin/promos/edit/@p.Id'">
                <div style="display:flex;align-items:center;gap:16px;flex:1;min-width:0;">
                    @if (p.IsVideo)
                    {
                        <video src="@p.ImageUrl" muted style="width:80px;height:44px;object-fit:cover;flex-shrink:0;border-radius:4px;"></video>
                    }
                    else
                    {
                        <img src="@p.ImageUrl" alt="" style="width:80px;height:44px;object-fit:cover;flex-shrink:0;border-radius:4px;" />
                    }
                    <div class="admin-list-item-info">
                        <h3>
                            @(string.IsNullOrEmpty(p.Heading) ? "(bez naslova)" : p.Heading)
                            @if (p.IsVideo)
                            {
                                <span class="admin-tab-count">video</span>
                            }
                        </h3>
                    </div>
                </div>
                <div class="admin-list-item-actions" onclick="event.stopPropagation()">
                    <form method="post" asp-page-handler="Move" asp-route-id="@p.Id" style="display:inline-flex;gap:4px;">
                        <button type="submit" name="direction" value="up" class="btn btn-outline btn-sm" title="Pomakni gore">↑</button>
                        <button type="submit" name="direction" value="down" class="btn btn-outline btn-sm" title="Pomakni dolje">↓</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id"
                          onsubmit="return confirm('Obriši ovaj promo?')">
                        <button type="submit" class="btn-icon-danger" title="Obriši">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
