@page
@model WorkshopZagreb.Pages.PrivacyModel
@{ ViewData["Title"] = "Privatnost"; }

<div class="static-page">
    <div class="static-page-header">
        <h1>Politika privatnosti</h1>
    </div>
    <div class="static-content">
        <p>Workshop Zagreb prikuplja vašu email adresu isključivo za slanje newslettera, na vaš izričit pristanak. Vaše podatke ne dijelimo s trećim stranama.</p>
        <p>Možete se odjaviti u bilo kojem trenutku klikom na link u svakom emailu. Za brisanje vaših podataka kontaktirajte nas na Instagramu.</p>
        <p>Koristimo kolačiće (cookies) isključivo za tehničko funkcioniranje stranice (sesija).</p>
    </div>
</div>
