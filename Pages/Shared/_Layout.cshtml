<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var _isHome = ViewData["IsHome"] as bool? == true;
        var _pageTitle = ViewData["Title"]?.ToString() ?? "";
        var _fullTitle = _isHome
            ? "Workshop Zagreb — Kreativne radionice u Zagrebu"
            : (_pageTitle + " – Workshop Zagreb");
        var _desc = ViewData["Description"] as string
            ?? "Jutarnja kava, poslijepodnevna kreativnost. Kreativne radionice u srcu Zagreba — akvarel, keramika, fotografija i više.";
        var _baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var _ogUrl   = _baseUrl + Context.Request.Path;
        var _ogImgRaw = ViewData["OgImage"] as string ?? "/images/lokacija.jpg";
        var _ogImage  = _ogImgRaw.StartsWith("http") ? _ogImgRaw : _baseUrl + _ogImgRaw;
        var _ogType   = ViewData["OgType"] as string ?? "website";
    }
    <title>@_fullTitle</title>
    <meta name="description" content="@_desc" />
    <link rel="canonical" href="@_ogUrl" />

    <!-- Open Graph -->
    <meta property="og:title"       content="@_fullTitle" />
    <meta property="og:description" content="@_desc" />
    <meta property="og:image"       content="@_ogImage" />
    <meta property="og:url"         content="@_ogUrl" />
    <meta property="og:type"        content="@_ogType" />
    <meta property="og:site_name"   content="Workshop Zagreb" />
    <meta property="og:locale"      content="hr_HR" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content="@_fullTitle" />
    <meta name="twitter:description" content="@_desc" />
    <meta name="twitter:image"       content="@_ogImage" />

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/png" href="/images/justLogo.png" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar" x-data="{ open: false }">
        <div class="nav-container">
            <a href="/" class="nav-logo">
                <img src="/images/justLogo.png" alt="" class="nav-logo-icon" />
                <img src="/images/logoText.png" alt="Workshop Zagreb" class="nav-logo-img" />
            </a>

            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/workshops">Workshops</a></li>
                <li><a href="/menu">Menu</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/suradnja">Collaborate</a></li>
                <li><a href="/faq">FAQ</a></li>
                <li><a href="/gallery">Gallery</a></li>
            </ul>

            <button class="nav-hamburger" @@click="open = !open" aria-label="Menu">
                <span></span><span></span><span></span>
            </button>
        </div>

        <div class="nav-mobile" x-show="open" x-transition @@click.outside="open = false">
            <a href="/"          @@click="open=false">Home</a>
            <a href="/workshops" @@click="open=false">Workshops</a>
            <a href="/menu"      @@click="open=false">Menu</a>
            <a href="/about"     @@click="open=false">About</a>
            <a href="/suradnja"  @@click="open=false">Collaborate</a>
            <a href="/faq"       @@click="open=false">FAQ</a>
            <a href="/gallery"   @@click="open=false">Gallery</a>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <img src="/images/justLogo.png" alt="Workshop Zagreb"
                     style="height:32px; filter:brightness(0) invert(1); opacity:0.75; margin-bottom:10px;" />
                <p>Mornings for coffee. Afternoons for creativity.</p>
                <p style="margin-top:10px; font-size:0.8rem; opacity:0.5;">Henrika Degena 2, Zagreb</p>
            </div>
            <div class="footer-links">
                <a href="/workshops">Workshops</a>
                <a href="/about">About</a>
                <a href="/suradnja">Collaborate</a>
                <a href="/faq">FAQ</a>
                <a href="/privacy">Privacy</a>
            </div>
            <div class="footer-social" style="display:flex;gap:14px;">
                <a href="https://www.instagram.com/workshop.zagreb/" target="_blank" rel="noopener" aria-label="Instagram" class="icon-link">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2"/></svg>
                </a>
                <a href="mailto:hello@workshopzagreb.com" aria-label="Email" class="icon-link">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
                </a>
            </div>
        </div>
        <p class="footer-copy">© @DateTime.Now.Year Workshop Zagreb</p>
    </footer>

    <div class="popup-overlay"
         x-data="newsletterPopup()"
         x-show="show"
         x-transition.opacity
         style="display:none">
        <div class="popup-card" @@click.stop>
            <button class="popup-close" @@click="dismiss()">✕</button>
            <p class="popup-eyebrow">Newsletter</p>
            <h2 class="popup-title">Budite prvi kada stignu nove radionice.</h2>
            <p class="popup-sub">Obavijest čim otvorimo novu radionicu. Jednom ili dvaput mjesečno. Bez spama.</p>
            <form class="popup-form" @@submit.prevent="subscribe($event)">
                <input type="email" name="email" placeholder="your@email.com" required class="popup-input" />
                <button type="submit" class="btn btn-primary" x-text="submitted ? 'Check your inbox ✓' : 'Subscribe'"></button>
            </form>
            <p class="popup-gdpr">By subscribing you accept our <a href="/privacy">privacy policy</a>.</p>
        </div>
    </div>

    <script>
        function newsletterPopup() {
            return {
                show: false, submitted: false,
                init() {
                    // Signed up already — never show again, on any future visit.
                    if (localStorage.getItem('newsletter_subscribed')) return;
                    // Already shown once this browsing session — don't re-show on every page nav.
                    if (sessionStorage.getItem('newsletter_shown_session')) return;
                    setTimeout(() => {
                        this.show = true;
                        sessionStorage.setItem('newsletter_shown_session', '1');
                    }, 7000);
                },
                // Closing the popup just hides it for now — no permanent flag,
                // so it shows again on a future visit if they never signed up.
                dismiss() { this.show = false; },
                async subscribe(e) {
                    const email = e.target.querySelector('input[type=email]').value;
                    await fetch('/api/subscribe', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ email }) });
                    this.submitted = true;
                    localStorage.setItem('newsletter_subscribed', '1');
                    setTimeout(() => this.show = false, 2500);
                }
            }
        }
    </script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
